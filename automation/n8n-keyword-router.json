{
  "name": "Digireach Estates - Rule-Based WhatsApp Keyword Router (No AI/LLM)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "wacrm-incoming-webhook",
        "options": {}
      },
      "name": "Inbound Message Webhook (wacrm)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [220, 360]
    },
    {
      "parameters": {
        "functionCode": "// Extract message text from wacrm inbound webhook\nconst raw = items[0].json.body || items[0].json;\nconst messageText = (raw.text || raw.message || raw.body || '').toUpperCase();\nconst fromPhone = raw.from || raw.phone || '';\n\nlet route = 'DEFAULT';\n\nif (messageText.includes('PRICE')) {\n  route = 'PRICE';\n} else if (messageText.includes('CALLBACK')) {\n  route = 'CALLBACK';\n} else if (messageText.includes('RESCHEDULE')) {\n  route = 'RESCHEDULE';\n} else if (messageText.includes('CANCEL')) {\n  route = 'CANCEL';\n}\n\nreturn [{\n  json: {\n    from_phone: fromPhone,\n    raw_text: messageText,\n    route: route,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "name": "Parse Keyword Router (Rule-Based)",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [440, 360]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{$json.route}}",
        "rules": {
          "rules": [
            {
              "value2": "PRICE",
              "output": 0
            },
            {
              "value2": "CALLBACK",
              "output": 1
            },
            {
              "value2": "RESCHEDULE",
              "output": 2
            },
            {
              "value2": "CANCEL",
              "output": 3
            }
          ]
        }
      },
      "name": "Keyword Switch",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [660, 360]
    },
